{
  "name": "oat-sa/bundle-scoring-engine",
  "description": "Scoring Engine Bundle",
  "keywords": [
    "symfony",
    "scoring",
    "engine",
    "bundle"
  ],
  "type": "symfony-bundle",
  "license": "AGPL-3.0-only OR LicenseRef-TAO-Commercial-License",
  "require": {
    "php": ">=7.4",
    "ext-json": "*",
    "symfony/framework-bundle": "~5.4 || ^6.0",
    "symfony/serializer": "~5.4 || ^6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.5"
  },
  "config": {
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "OAT\\Bundle\\ScoringEngineBundle\\": ""
    },
    "exclude-from-classmap": [
      "/Tests/"
    ]
  },
  "authors": [
    {
      "name": "Open Assessment Technologies S.A.",
      "homepage": "https://www.taotesting.com"
    }
  ]
}
